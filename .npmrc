; Public project: always resolve against the public npm registry, overriding
; any machine-level registry configuration (e.g. a corporate proxy registry),
; so package-lock.json stays installable on CI.
registry=https://registry.npmjs.org/

; Supply-chain guard: only resolve package versions published at least 7 days
; ago (value is in days), so freshly compromised releases age out before we
; can pick them up. Only affects dependency resolution (install/update), not
; `npm ci` from the lockfile.
min-release-age=7
